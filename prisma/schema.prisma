generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  FREELANCER
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum KycDocumentType {
  NIN
  PASSPORT
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobCategory {
  WEB_DEVELOPMENT
  MOBILE_DEVELOPMENT
  DESIGN
  WRITING
  MARKETING
  DATA
  OTHER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum TransactionStatus {
  COMPLETED
  FAILED
}

enum TransactionType {
  MILESTONE_PAYMENT
  REFUND
  WITHDRAWAL
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String   @unique
  passwordHash    String
  role            Role     @default(CLIENT)
  avatar          String   @default("")
  bio             String   @default("")
  location        String   @default("")
  skills          String[] @default([])
  hourlyRate      Decimal? @db.Decimal(10, 2)
  balance         Decimal  @default(0) @db.Decimal(10, 2)
  isActive        Boolean  @default(true)

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  kycStatus       KycStatus        @default(NOT_SUBMITTED)
  kycDocumentType KycDocumentType?
  kycDocumentNo   String?
  kycDocumentImg  String?
  kycReviewedAt   DateTime?
   kycRejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  withdrawals Withdrawal[]
  refreshTokens        RefreshToken[]
  otpTokens            OtpToken[]
  jobsPosted           Job[]          @relation("JobsPosted")
  jobsHired            Job[]          @relation("JobsHired")
  proposals            Proposal[]     @relation("Proposals")
  projectsAsClient     Project[]      @relation("ProjectsAsClient")
  projectsAsFreelancer Project[]      @relation("ProjectsAsFreelancer")
  transactionsSent     Transaction[] @relation("TransactionsSent")
  transactionsReceived Transaction[] @relation("TransactionsReceived")
  conversationsAsClient     Conversation[] @relation("ConversationsClient")
  conversationsAsFreelancer Conversation[] @relation("ConversationsFreelancer")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  type       OtpType   @default(EMAIL_VERIFICATION)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
}

model Job {
  id                String      @id @default(uuid())
  clientId          String
  client            User        @relation("JobsPosted", fields: [clientId], references: [id])
  title             String
  description       String
  category          JobCategory
  skillsRequired    String[]    @default([])
  budgetMin         Decimal     @db.Decimal(10, 2)
  budgetMax         Decimal     @db.Decimal(10, 2)
  status            JobStatus   @default(OPEN)
  hiredFreelancerId String?
  hiredFreelancer   User?       @relation("JobsHired", fields: [hiredFreelancerId], references: [id])
  deadline          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  proposals Proposal[]
  project   Project?

  @@index([status, createdAt])
  @@index([clientId, status])
}

model Proposal {
  id            String         @id @default(uuid())
  jobId         String
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId  String
  freelancer    User           @relation("Proposals", fields: [freelancerId], references: [id], onDelete: Cascade)
  coverLetter   String
  bidAmount     Decimal        @db.Decimal(10, 2)
  estimatedDays Int
  status        ProposalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  attachments   String[]       @default([])

  project Project?

  @@unique([jobId, freelancerId])
  @@index([jobId, status])
}

model Project {
  id           String        @id @default(uuid())
  jobId        String        @unique
  job          Job           @relation(fields: [jobId], references: [id])
  proposalId   String        @unique
  proposal     Proposal      @relation(fields: [proposalId], references: [id])
  clientId     String
  client       User          @relation("ProjectsAsClient", fields: [clientId], references: [id])
  freelancerId String
  freelancer   User          @relation("ProjectsAsFreelancer", fields: [freelancerId], references: [id])
  title        String
  description  String
  budget       Decimal       @db.Decimal(10, 2)
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime      @default(now())
  endDate      DateTime?

  milestones Milestone[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clientId, status])
  @@index([freelancerId, status])
  conversation Conversation?
}

model Milestone {
  id                 String          @id @default(uuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String
  amount             Decimal         @db.Decimal(10, 2)
  dueDate            DateTime
  status             MilestoneStatus @default(PENDING)
  submission         String          @default("")
  rejectionReason    String          @default("")
  submissionAttempts Int             @default(0)
  attachments String[] @default([])
  submittedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([projectId, status])
  @@index([dueDate, status])
}

model Transaction {
  id          String            @id @default(uuid())
  milestoneId String?           @unique
  projectId   String?
  fromUserId  String
  fromUser    User              @relation("TransactionsSent", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User              @relation("TransactionsReceived", fields: [toUserId], references: [id])
  amount      Decimal           @db.Decimal(10, 2)
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  createdAt   DateTime          @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model Conversation {
  id           String    @id @default(uuid())
  projectId    String    @unique
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String
  client       User      @relation("ConversationsClient", fields: [clientId], references: [id])
  freelancerId String
  freelancer   User      @relation("ConversationsFreelancer", fields: [freelancerId], references: [id])
  createdAt    DateTime  @default(now())
  messages     Message[]
  updatedAt    DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Withdrawal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  bankName      String
  accountNumber String
  status        String   @default("PROCESSING")
  createdAt     DateTime @default(now())

  @@index([userId])
}