{
  "name": "workbridge-api",
  "version": "1.0.0",
  "description": "WorkBridge — freelance marketplace backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "node scripts/seed.js",
    "killport": "node -e \"require('child_process').exec('netstat -ano | findstr :5000', (e, out) => { const pid = out.trim().split(/\\s+/).pop(); if (pid && pid !== '0') { require('child_process').execSync('taskkill /PID ' + pid + ' /F'); console.log('killed', pid); } else console.log('port 5000 free'); })\"",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "prisma": "^5.18.0",
    "supertest": "^7.3.1"
  }
}
